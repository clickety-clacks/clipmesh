[Unit]
Description=ClipMesh desktop agent
After=graphical-session.target
PartOf=graphical-session.target

[Service]
Type=simple
ExecStart=@@CLIPMESH_AGENT_BINARY@@ --config @@CLIPMESH_CONFIG_PATH@@
Environment="CLIPMESH_HUB_URL=@@CLIPMESH_HUB_URL@@"
Environment="CLIPMESH_STATE_PATH=@@CLIPMESH_STATE_PATH@@"
Environment="CLIPMESH_CONTROL_SOCKET=@@CLIPMESH_CONTROL_SOCKET@@"
Restart=no
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict

[Install]
WantedBy=default.target
